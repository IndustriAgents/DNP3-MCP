# Example settings for dnp3-mcp. Copy to dnp3-python/.env (or to a file you
# pass with --env-file) and adjust. Every variable is optional; the defaults
# are shown.
#
# The implicit .env is read ONLY from dnp3-python/ of a source checkout, found
# next to the package source: never from the directory the server is started
# in, nor from a parent, because an MCP client may start the server inside its
# own (untrusted) project. An installed package has no implicit .env; use the
# environment or --env-file. That file may set only DNP3_* settings and
# POINT_MAP_FILE: anything else (PATH, PYTHON*, DYLD_*, proxies, ...) and any
# spelling of DNP3_WRITES_ENABLED is ignored with a warning on stderr.

# Connection (TCP only; serial is not implemented)
DNP3_CONNECTION_TYPE=tcp
DNP3_HOST=127.0.0.1
DNP3_PORT=20000

# This master's link address. Against real equipment, use an address and
# association of its own, never the production master's (1 is common there).
DNP3_MASTER_ADDRESS=1

# Milliseconds for the TCP connect and each request/response exchange.
DNP3_TIMEOUT=5000
# Extra attempts for reads and polls only; controls are never retried.
DNP3_MAX_RETRIES=3
# select_before_operate or direct_operate
DNP3_CONTROL_MODE=select_before_operate

# Optional JSON point map.
# POINT_MAP_FILE=/absolute/path/to/points.json

# Write switch. It is IGNORED (with a warning on stderr) when it comes from the
# implicit dnp3-python/.env, in any case or with "export". Set it in the real
# environment (for example the MCP client's "env" block) or in a file passed
# with --env-file:
#   uv run dnp3-mcp --env-file /path/to/this-file
# DNP3_WRITES_ENABLED=false
